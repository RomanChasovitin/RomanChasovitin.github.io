---
// One button per project: under the terminal in the hero, and under the window of every project screen,
// where the current project is marked. The colors follow --nav-ink and --nav-paper; `dark` sets them for
// dark screens.
// On a marked button an icon may change: the Mad Devs M turns white on its red.
//
// The row starts with Intro, the way back to the hero; in the hero it is the marked one. Below 1024px the row
// stays one line, scrolls sideways and sits over the window; it always starts at Intro, so the way back is in
// view.
import { brandIcon } from '../content/icons';
import { projects, type ProjectId } from '../content/projects';

type Props = { current?: ProjectId; dark?: boolean };

const { current, dark = false } = Astro.props;
const markedIcon: Partial<Record<ProjectId, string>> = { maddevs: '/icons/maddevs-active.svg' };
---

<nav class:list={['projects', { dark }]} aria-label="Projects">
  <a class="project intro" href="#intro" aria-current={current ? undefined : 'page'}>
    <img src="/avatar.jpg" alt="" width="64" height="64" />
    Intro
  </a>
  {
    projects.map((project) => (
      <a
        class="project"
        href={`#${project.id}`}
        aria-current={project.id === current ? 'page' : undefined}
      >
        <img src={(project.id === current && markedIcon[project.id]) || brandIcon[project.id]} alt="" width="64" height="64" />
        {project.name}
      </a>
    ))
  }
</nav>

<style>
  .projects {
    display: flex;
    flex-shrink: 0;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  @media (width < 1024px) {
    .projects {
      flex-wrap: nowrap;
      margin-inline: -5vw;
      padding-inline: 5vw;
      overflow-x: auto;
      scrollbar-width: none;
      order: -1;
    }

    .project {
      flex-shrink: 0;
    }
  }

  .dark {
    --nav-ink: #fff;
    --nav-paper: #111;
  }

  .project {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.4em 1em 0.4em 0.45em;
    border: 1px solid color-mix(in srgb, var(--nav-ink, #000) 16%, transparent);
    border-radius: 999px;
    color: var(--nav-ink, #000);
    font-family: 'Bricolage Grotesque Variable', var(--font-geist);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;

    & img {
      width: 1.6em;
      height: 1.6em;
      border-radius: 0.4em;
    }

    &:hover,
    &:focus-visible {
      border-color: var(--nav-ink, #000);
      background: color-mix(in srgb, var(--nav-ink, #000) 8%, transparent);
    }

    &.intro img {
      border-radius: 50%;
      object-fit: cover;
    }

    &[aria-current='page'] {
      border-color: var(--nav-ink, #000);
      background: var(--nav-ink, #000);
      color: var(--nav-paper, #fff);
    }
  }
</style>

