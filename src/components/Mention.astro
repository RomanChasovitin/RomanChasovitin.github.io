---
// A technology, company or contact inside running text: a color icon and an underlined link.
import {
  siAngular,
  siGithub,
  siGo,
  siNextdotjs,
  siNodedotjs,
  siPython,
  siReact,
  siTelegram,
  siTypescript,
  siVuedotjs,
} from 'simple-icons';
import { brandIcon } from '../content/icons';
import type { IconName } from '../content/profile';

type Props = { icon: IconName; href: string; label: string };

const { icon, href, label } = Astro.props;

const brandIcons = {
  typescript: siTypescript,
  react: siReact,
  nextjs: siNextdotjs,
  vue: siVuedotjs,
  angular: siAngular,
  node: siNodedotjs,
  python: siPython,
  go: siGo,
  github: siGithub,
  telegram: siTelegram,
};
// Company icons, see content/icons.ts.
const images: Partial<Record<IconName, string>> = {
  ...brandIcon,
  besmart: '/icons/besmart.svg',
};

const brand = icon in brandIcons ? brandIcons[icon as keyof typeof brandIcons] : null;
// Black marks (Angular, GitHub, Next.js) take the text color, so they stay visible on a dark background.
const black = (hex: string) => [0, 2, 4].every((index) => parseInt(hex.slice(index, index + 2), 16) < 0x40);
const image = images[icon];
const external = /^https?:/.test(href);
---

<a class="mention" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
  {
    brand ? (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d={brand.path} fill={black(brand.hex) ? 'currentColor' : `#${brand.hex}`} />
      </svg>
    ) : image ? (
      <img src={image} alt="" width="64" height="64" />
    ) : icon === 'linkedin' ? (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect width="24" height="24" rx="4" fill="#0a66c2" />
        <circle cx="7" cy="6.6" r="1.8" fill="#fff" />
        <rect x="5.4" y="9.4" width="3.2" height="9.4" fill="#fff" />
        <path
          d="M10.9 9.4h3v1.3c.5-.9 1.6-1.6 3.1-1.6 3 0 3.6 1.9 3.6 4.4v5.3h-3.1v-4.7c0-1.2 0-2.6-1.7-2.6s-1.9 1.3-1.9 2.5v4.8h-3z"
          fill="#fff"
        />
      </svg>
    ) : icon === 'email' ? (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="1.5" y="4" width="21" height="16" rx="3" fill="#ea4335" />
        <path d="m4.5 7.5 7.5 6 7.5-6" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" />
      </svg>
    ) : (
      <span class="monogram" aria-hidden="true">
        {label[0]}
      </span>
    )
  }<span class="label">{label}</span>
</a>

<style>
  .mention {
    color: inherit;
    white-space: nowrap;
    text-decoration: none;
  }

  svg,
  img,
  .monogram {
    display: inline-block;
    width: 1em;
    height: 1em;
    margin-right: 0.3em;
    vertical-align: -0.14em;
  }

  img {
    border-radius: 0.22em;
  }

  .monogram {
    border-radius: 0.22em;
    background: #2f9e6e;
    color: #fff;
    font-size: 0.8em;
    font-weight: 700;
    line-height: 1.25em;
    text-align: center;
    width: 1.25em;
    height: 1.25em;
  }

  .label {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 200ms ease;
  }

  .mention:hover .label,
  .mention:focus-visible .label {
    text-decoration-color: currentColor;
  }
</style>
