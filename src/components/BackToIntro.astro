---
// Every project screen has one: a real button, dressed in each screen's brand through `class`.
// By default it sits top left of the screen; `inline` puts it in the flow, for screens with a centered column.
type Props = { class?: string; inline?: boolean };

const { class: className, inline = false } = Astro.props;
---

<a href="#intro" class:list={['back', { 'back-inline': inline }, className]}>Back to intro</a>

<style>
  .back {
    position: absolute;
    top: 3.5svh;
    left: 5vw;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    padding: 0.55em 1.15em;
    text-decoration: none;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }

  .back-inline {
    position: static;
    align-self: flex-start;
  }
</style>
