---
// Every project screen has one, top left: a real button, dressed in each screen's brand through `class`.
type Props = { class?: string };

const { class: className } = Astro.props;
---

<a href="#intro" class:list={['back', className]}>Back to intro</a>

<style>
  .back {
    position: absolute;
    top: 3.5svh;
    left: 5vw;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    padding: 0.55em 1.15em;
    text-decoration: none;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }
</style>
