---
import { profile } from '../content/profile';
import Base from '../layouts/Base.astro';
import About from '../screens/about/About.astro';
import BileBile from '../screens/bilebile/BileBile.astro';
import Chocolife from '../screens/chocolife/Chocolife.astro';
import ExParte from '../screens/exparte/ExParte.astro';
import Hero from '../screens/Hero.astro';
import MadDevs from '../screens/maddevs/MadDevs.astro';
import Teacherly from '../screens/teacherly/Teacherly.astro';
---

<Base title={profile.name} description={`${profile.name}, ${profile.headline.toLowerCase()}.`}>
  <main>
    <Hero />
    <ExParte />
    <MadDevs />
    <BileBile />
    <Teacherly />
    <Chocolife />
    <About />
  </main>
</Base>

<script>
  import '../scripts/router';
</script>
