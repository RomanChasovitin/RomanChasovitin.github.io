---
import { profile } from '../content/profile';
import { projects, type ProjectId } from '../content/projects';
import Base from '../layouts/Base.astro';
import BileBile from '../screens/bilebile/BileBile.astro';
import ExParte from '../screens/exparte/ExParte.astro';
import Hero from '../screens/Hero.astro';
import MadDevs from '../screens/maddevs/MadDevs.astro';
import Placeholder from '../screens/Placeholder.astro';

// Brand base colors for the screens that are not built yet.
const placeholders: Partial<Record<ProjectId, { background: string; foreground: string; step: number }>> = {
  teacherly: { background: '#F9F7FF', foreground: '#322D4D', step: 5 },
  chocolife: { background: '#F2F2F2', foreground: '#303030', step: 6 },
};
---

<Base title={profile.name} description={`${profile.name}, ${profile.headline.toLowerCase()}.`}>
  <main>
    <Hero />
    <ExParte />
    <MadDevs />
    <BileBile />
    {
      projects.map((project) => {
        const look = placeholders[project.id];
        return look && <Placeholder project={project} {...look} />;
      })
    }
  </main>
</Base>

<script>
  import '../scripts/router';
</script>
