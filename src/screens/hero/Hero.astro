---
// The landing screen: me on the left, an agent that knows my work on the right, and under it one button per
// project. A project screen grows out of its button and folds back into it.
import Mention from '../../components/Mention.astro';
import { brandIcon } from '../../content/icons';
import { profile } from '../../content/profile';
import { projects } from '../../content/projects';
import Terminal from './Terminal';

const [first, ...rest] = profile.name.split(' ');
---

<section id="intro" data-screen class="hero">
  <div class="layout">
    <div class="me">
      <h1 class="name">
        <img class="avatar" src="/avatar.jpg" alt="" width="330" height="330" />
        <span class="lines"><span>{first}</span><span>{rest.join(' ')}</span></span>
      </h1>
      <p class="about">
        {
          profile.about.map((part) =>
            typeof part === 'string' ? part : <Mention icon={part.icon} href={part.href} label={part.label} />,
          )
        }
      </p>
      <p class="now">
        Now at <Mention icon={profile.now.icon} href={profile.now.href} label={profile.now.label} />
      </p>
      <p class="contacts">
        {profile.contacts.map((contact) => <Mention icon={contact.icon} href={contact.href} label={contact.label} />)}
      </p>
    </div>

    <div class="agent">
      <div class="window">
        <Terminal client:idle />
      </div>
      <nav class="projects" aria-label="Projects">
        {
          projects.map((project) => (
            <a class="project" href={`#${project.id}`} data-opens={project.id}>
              <img src={brandIcon[project.id]} alt="" width="64" height="64" />
              {project.name}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</section>

<style>
  .hero {
    background: #fff;
    color: #000;
    font-family: 'Bricolage Grotesque Variable', var(--font-geist);
  }

  .layout {
    display: flex;
    align-items: center;
    gap: 4vw;
    height: 100%;
    padding: 0 5vw;
  }

  .me {
    width: 34vw;
    flex-shrink: 0;
  }

  .name {
    display: flex;
    align-items: center;
    gap: 0.22em;
    font-size: clamp(2.8rem, 4.6vw, 5.5rem);
    font-weight: 800;
    font-variation-settings:
      'wdth' 75,
      'opsz' 96;
    line-height: 0.86;
    letter-spacing: -0.035em;
  }

  /* As tall as the two lines of the name. */
  .avatar {
    width: 1.72em;
    height: 1.72em;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
  }

  .lines span {
    display: block;
  }

  .about {
    max-width: 34em;
    margin-top: 2.2rem;
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .now {
    margin-top: 1em;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em 1.8em;
    margin-top: 2.2rem;
    font-weight: 600;
  }

  .agent {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    height: 84svh;
  }

  .window {
    flex: 1;
    min-height: 0;
  }

  .projects {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .project {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.4em 1em 0.4em 0.45em;
    border: 1px solid rgb(0 0 0 / 0.14);
    border-radius: 999px;
    color: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;

    & img {
      width: 1.6em;
      height: 1.6em;
      border-radius: 0.4em;
    }

    &:hover,
    &:focus-visible {
      border-color: #000;
      background: #000;
      color: #fff;
    }
  }

  /* On load the column rises line by line, then the agent comes in. */
  .me > * {
    animation: lift 800ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .me > :nth-child(2) {
    animation-delay: 80ms;
  }

  .me > :nth-child(3) {
    animation-delay: 140ms;
  }

  .me > :nth-child(4) {
    animation-delay: 200ms;
  }

  .agent {
    animation: lift 900ms cubic-bezier(0.2, 0.8, 0.2, 1) 250ms both;
  }

  @keyframes lift {
    from {
      opacity: 0;
      translate: 0 1.2rem;
    }
  }

  /* Narrow screens: the column on top, the agent under it, and the screen scrolls. */
  @media (max-width: 899px) {
    .hero {
      overflow-y: auto;
    }

    .layout {
      flex-direction: column;
      align-items: stretch;
      height: auto;
      padding: 6svh 6vw;
    }

    .me {
      width: auto;
    }

    .name {
      font-size: clamp(2.6rem, 11vw, 4.5rem);
    }

    .agent {
      flex: none;
      height: 75svh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .me > *,
    .agent {
      animation: none;
    }
  }
</style>
