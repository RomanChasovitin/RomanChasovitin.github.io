---
// The landing screen: me on the left, an agent that knows my work on the right, and under it one button per
// project. A project screen grows out of its button and folds back into it.
//
// The hero has a light and a dark theme, and only the hero: project screens keep their brands. The theme
// follows the system until the visitor picks one with the button in the corner or /theme in the terminal.
import Mention from '../../components/Mention.astro';
import { brandIcon } from '../../content/icons';
import { profile } from '../../content/profile';
import { projects } from '../../content/projects';
import Terminal from './Terminal';

const [first, ...rest] = profile.name.split(' ');
---

<section id="intro" data-screen class="hero">
  <script is:inline>
    // Before the first paint, so the hero never shows in the wrong theme for a moment.
    (() => {
      const hero = document.currentScript.parentElement;
      let saved = null;
      try {
        saved = localStorage.getItem('hero-scheme');
      } catch {}
      hero.dataset.scheme = saved ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    })();
  </script>

  <button type="button" class="scheme" data-scheme-toggle aria-label="Switch to the dark theme">
    <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
    </svg>
    <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
  </button>

  <div class="layout">
    <div class="me">
      <h1 class="name">
        <img class="avatar" src="/avatar.jpg" alt="" width="330" height="330" />
        <span class="lines"><span>{first}</span><span>{rest.join(' ')}</span></span>
      </h1>
      <p class="about">
        {
          profile.about.map((part) =>
            typeof part === 'string' ? part : <Mention icon={part.icon} href={part.href} label={part.label} />,
          )
        }
      </p>
      <p class="now">
        Now at <Mention icon={profile.now.icon} href={profile.now.href} label={profile.now.label} />
      </p>
      <p class="contacts">
        {profile.contacts.map((contact) => <Mention icon={contact.icon} href={contact.href} label={contact.label} />)}
      </p>
    </div>

    <div class="agent">
      <div class="window">
        <Terminal client:idle />
      </div>
      <nav class="projects" aria-label="Projects">
        {
          projects.map((project) => (
            <a class="project" href={`#${project.id}`} data-opens={project.id}>
              <img src={brandIcon[project.id]} alt="" width="64" height="64" />
              {project.name}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</section>

<style>
  /* The terminal reads these too, including the brand colors of its output. */
  .hero {
    --paper: #fff;
    --ink: #000;
    --dim: #6e6e6e;
    --rule: rgb(0 0 0 / 0.1);
    --window: #fff;
    --bar: #f6f6f6;
    --chip: rgb(0 0 0 / 0.14);
    --placeholder: rgb(0 0 0 / 0.35);
    --ok: #0a7d3b;
    --warn: #9a6700;
    --bad: #b42318;
    --brand-exparte: #0061ff;
    --brand-maddevs: #ec1c24;
    --brand-bilebile: #e63445;
    --brand-teacherly: #4e409b;
    --brand-chocolife: #2e3a82;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Bricolage Grotesque Variable', var(--font-geist);
    transition:
      background-color 300ms ease,
      color 300ms ease;
  }

  .hero[data-scheme='dark'] {
    --paper: #0d0d0e;
    --ink: #f1f1f1;
    --dim: #8d8d8d;
    --rule: rgb(255 255 255 / 0.1);
    --window: #151517;
    --bar: #1d1d20;
    --chip: rgb(255 255 255 / 0.16);
    --placeholder: rgb(255 255 255 / 0.35);
    --ok: #3fb950;
    --warn: #d29922;
    --bad: #f47067;
    --brand-exparte: #5b8cff;
    --brand-maddevs: #ff5b61;
    --brand-bilebile: #ff7482;
    --brand-teacherly: #a99bf5;
    --brand-chocolife: #8f9cf3;
  }

  .scheme {
    position: absolute;
    top: 3.5svh;
    right: 5vw;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--chip);
    border-radius: 50%;
    color: inherit;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;

    & svg {
      grid-area: 1 / 1;
      width: 1.15rem;
      height: 1.15rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition:
        opacity 300ms ease,
        rotate 400ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    &:hover,
    &:focus-visible {
      border-color: var(--ink);
      background: var(--ink);
      color: var(--paper);
    }
  }

  /* The icon shows the theme a click switches to. */
  .hero[data-scheme='dark'] .moon,
  .hero:not([data-scheme='dark']) .sun {
    opacity: 0;
    rotate: -90deg;
  }

  .layout {
    display: flex;
    align-items: center;
    gap: 4vw;
    height: 100%;
    padding: 0 5vw;
  }

  .me {
    width: 34vw;
    flex-shrink: 0;
  }

  .name {
    display: flex;
    align-items: center;
    gap: 0.22em;
    font-size: clamp(2.8rem, 4.6vw, 5.5rem);
    font-weight: 800;
    font-variation-settings:
      'wdth' 75,
      'opsz' 96;
    line-height: 0.86;
    letter-spacing: -0.035em;
  }

  /* As tall as the two lines of the name. */
  .avatar {
    width: 1.72em;
    height: 1.72em;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
  }

  .lines span {
    display: block;
  }

  .about {
    max-width: 34em;
    margin-top: 2.2rem;
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .now {
    margin-top: 1em;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em 1.8em;
    margin-top: 2.2rem;
    font-weight: 600;
  }

  .agent {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    height: 84svh;
  }

  .window {
    flex: 1;
    min-height: 0;
  }

  .projects {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .project {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.4em 1em 0.4em 0.45em;
    border: 1px solid var(--chip);
    border-radius: 999px;
    color: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;

    & img {
      width: 1.6em;
      height: 1.6em;
      border-radius: 0.4em;
    }

    &:hover,
    &:focus-visible {
      border-color: var(--ink);
      background: var(--ink);
      color: var(--paper);
    }
  }

  /* On load the column rises line by line, then the agent comes in. */
  .me > * {
    animation: lift 800ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .me > :nth-child(2) {
    animation-delay: 80ms;
  }

  .me > :nth-child(3) {
    animation-delay: 140ms;
  }

  .me > :nth-child(4) {
    animation-delay: 200ms;
  }

  .agent {
    animation: lift 900ms cubic-bezier(0.2, 0.8, 0.2, 1) 250ms both;
  }

  @keyframes lift {
    from {
      opacity: 0;
      translate: 0 1.2rem;
    }
  }

  /* Narrow screens: the column on top, the agent under it, and the screen scrolls. */
  @media (max-width: 899px) {
    .hero {
      overflow-y: auto;
    }

    .layout {
      flex-direction: column;
      align-items: stretch;
      height: auto;
      padding: 6svh 6vw;
    }

    .me {
      width: auto;
    }

    .name {
      font-size: clamp(2.6rem, 11vw, 4.5rem);
    }

    .agent {
      flex: none;
      height: 75svh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .me > *,
    .agent {
      animation: none;
    }
  }
</style>

<script>
  const KEY = 'hero-scheme';
  type Scheme = 'light' | 'dark';

  const hero = document.getElementById('intro')!;
  const toggle = hero.querySelector<HTMLButtonElement>('[data-scheme-toggle]')!;
  const system = matchMedia('(prefers-color-scheme: dark)');

  function saved() {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  }

  function apply(scheme: Scheme) {
    hero.dataset.scheme = scheme;
    toggle.setAttribute('aria-label', `Switch to the ${scheme === 'dark' ? 'light' : 'dark'} theme`);
  }

  function choose(scheme: Scheme) {
    apply(scheme);
    try {
      localStorage.setItem(KEY, scheme);
    } catch {}
  }

  const other = (): Scheme => (hero.dataset.scheme === 'dark' ? 'light' : 'dark');

  toggle.addEventListener('click', () => choose(other()));
  // The terminal's /theme.
  document.addEventListener('scheme:set', (event) => {
    const { scheme } = (event as CustomEvent<{ scheme?: Scheme }>).detail;
    choose(scheme ?? other());
  });
  // Until the visitor picks a theme, the hero follows the system, even when it changes on the fly.
  system.addEventListener('change', () => saved() || apply(system.matches ? 'dark' : 'light'));
  apply(hero.dataset.scheme === 'dark' ? 'dark' : 'light');
</script>
