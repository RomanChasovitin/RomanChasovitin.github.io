---
// Mad Devs, after the old maddevs.io hero: the company on the left, a live Slack window on the right.
import BackToIntro from '../../components/BackToIntro.astro';
import ProjectIntro from '../../components/ProjectIntro.astro';
import ProjectNav from '../../components/ProjectNav.astro';
import Slack from './Slack';
---

<section id="maddevs" data-screen class="overflow-hidden bg-md-ink font-inter text-white">
  <BackToIntro class="rounded-full border border-md-grey text-sm font-medium text-white hover:bg-white hover:text-md-ink" />

  <div class="flex h-full items-center gap-[4vw] px-[5vw]">
    <ProjectIntro id="maddevs" slogan="My home company since 2018" mono="font-plex-mono" body="text-md-grey" muted="text-md-grey" dim="text-md-grey">
      I lead the internal team behind maddevs.io and a few internal tools, lead the small ITC team and mentor
      interns. Client work came through Mad Devs too: Teacherly, Bile-Bile and Ex Parte. Before that, part-time, the
      landing page and front end of the Elcart mobile bank.
    </ProjectIntro>

    <div class="stage">
      <div class="mac dark">
        <div class="mac-bar" aria-hidden="true">
          <span class="mac-lights"><i></i><i></i><i></i></span>
          <span class="mac-title">Slack — Mad Devs</span>
        </div>
        <div class="min-h-0 flex-1">
          <Slack client:idle />
        </div>
      </div>
      <ProjectNav current="maddevs" dark />
    </div>
  </div>
</section>
