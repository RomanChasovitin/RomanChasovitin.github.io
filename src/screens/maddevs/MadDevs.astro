---
// Mad Devs, after the old maddevs.io hero: the company on the left, and on the right a browser with the team
// Slack and my page in enji.ai.
import ProjectIntro from '../../components/ProjectIntro.astro';
import ProjectNav from '../../components/ProjectNav.astro';
import Workspace from './Workspace';
---

<section id="maddevs" data-screen class="overflow-hidden bg-md-ink font-inter text-white">

  <div class="split">
    <ProjectIntro id="maddevs" slogan="My home company since 2018" body="text-md-grey" muted="text-md-grey" dim="text-md-grey">
      I lead the internal team behind maddevs.io and a few internal tools, lead the small ITC team and mentor
      interns, and I helped build the first employee interface of enji.ai. Client work came through Mad Devs too:
      Teacherly, Bile-Bile and Ex Parte.
    </ProjectIntro>

    <div class="stage">
      <div class="stage-window">
        <Workspace client:idle />
      </div>
      <ProjectNav current="maddevs" dark />
    </div>
  </div>
</section>
