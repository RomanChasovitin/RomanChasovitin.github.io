---
// Chocolife and BeSmart, the product: what a coupon goes through, from the deal feed to the venue. Laid out
// like Mad Devs: the story on the left, a working browser window on the right.
//
// The whole screen wears the brand picked over the window: one dot grid over light pink and white for
// Chocolife, over light blue and white for BeSmart. The shop sets `data-brand` on the screen, and the
// backdrops cross-fade.
import ProjectIntro from '../../components/ProjectIntro.astro';
import ProjectNav from '../../components/ProjectNav.astro';
import Shop from './Shop';
---

<section id="chocolife" data-screen data-brand="chocolife" class="chocolife overflow-hidden bg-(--cl-bg) font-roboto text-(--cl-body)">
  <div class="backdrop choco" aria-hidden="true"></div>
  <div class="backdrop besmart" aria-hidden="true"></div>

  <div class="split relative">
    <ProjectIntro id="chocolife" slogan="Half price on the best of the city" accent="text-(--cl-heading)" also="/icons/besmart.svg" body="text-(--cl-body)" muted="text-(--cl-muted)" dim="text-(--cl-muted)">
      Chocolife sells coupons for restaurants, spas, aquaparks and trips at up to half price: buy on the site, get
      the coupon by email, show its code at the venue. BeSmart did the same in Kazakhstan and Kyrgyzstan. My first
      job: Chocolife on Angular 2+, BeSmart on React, MobX and GraphQL.
    </ProjectIntro>

    <!-- Stacked, the row of projects is over the window, and the brand icons need room under it. -->
    <div class="stage max-lg:gap-[3.4rem]">
      <div class="stage-window max-lg:h-[calc(100%-5.8rem)]">
        <Shop client:idle />
      </div>
      <ProjectNav current="chocolife" />
    </div>
  </div>
</section>

<style>
  .chocolife {
    --cl-bg: #fff4f7;
    --cl-heading: var(--color-cl-navy);
    --cl-body: var(--color-cl-ink);
    --cl-muted: #8a7b81;
    --nav-ink: #1d2352;
    --nav-paper: #fff;
    transition:
      background-color 500ms ease,
      color 500ms ease;
  }

  .chocolife[data-brand='besmart'] {
    --cl-bg: #f1f7ff;
    --cl-heading: #1a6bc6;
    --cl-muted: #74818f;
    --nav-ink: #0f3d73;
  }

  /* Fixed, so a stacked screen scrolls over it. */
  .backdrop {
    position: fixed;
    inset: 0;
    pointer-events: none;
    transition: opacity 500ms ease;
  }

  /* Chocolife: light pink running into white, under a coupon-like dot grid. */
  .choco {
    background:
      radial-gradient(rgb(46 58 130 / 0.1) 1.2px, transparent 1.5px) 0 0 / 22px 22px,
      radial-gradient(48vmax 48vmax at 0% 0%, rgb(255 190 210 / 0.75), transparent 70%),
      linear-gradient(135deg, #ffe4ec 0%, #fff 60%);
  }

  /* BeSmart: the same dot grid, in the blue of its logo, over light blue running into white. */
  .besmart {
    opacity: 0;
    background:
      radial-gradient(rgb(26 107 198 / 0.12) 1.2px, transparent 1.5px) 0 0 / 22px 22px,
      radial-gradient(48vmax 48vmax at 0% 0%, rgb(170 208 250 / 0.75), transparent 70%),
      linear-gradient(135deg, #deeeff 0%, #fff 60%);
  }

  .chocolife[data-brand='besmart'] {
    & .choco {
      opacity: 0;
    }

    & .besmart {
      opacity: 1;
    }
  }
</style>
