---
// Teacherly, in its own look: white, purple buttons, big color blobs at the edges.
import ProjectIntro from '../../components/ProjectIntro.astro';
import ProjectNav from '../../components/ProjectNav.astro';
import Lesson from './Lesson';
---

<section id="teacherly" data-screen class="overflow-hidden bg-white font-helvetica text-tl-ink">
  <div class="blob yellow" aria-hidden="true"></div>
  <div class="blob teal" aria-hidden="true"></div>
  <div class="blob sky" aria-hidden="true"></div>
  <div class="split relative [--split-gap:3.5vw]">
    <ProjectIntro id="teacherly" slogan="Turning teachers into teams" accent="text-tl-purple" body="text-tl-ink" muted="text-tl-ink/70" dim="text-tl-ink/60">
      A British ed-tech startup for schools: teachers build interactive lessons, put them in the timetable of a
      class, teach them on video calls and grade the students, with the curriculum behind it all. Video classes came
      at the 2020 peak.
    </ProjectIntro>

    <div class="stage">
      <div class="stage-window">
        <Lesson client:idle />
      </div>
      <ProjectNav current="teacherly" />
    </div>
  </div>
</section>

<style>
  .blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .yellow {
    top: -14vw;
    left: -9vw;
    width: 28vw;
    aspect-ratio: 1;
    background: var(--color-tl-yellow);
  }

  .teal {
    right: -8vw;
    bottom: -12vw;
    width: 26vw;
    aspect-ratio: 1;
    background: var(--color-tl-teal);
  }

  .sky {
    bottom: 6svh;
    left: 22vw;
    width: 5vw;
    aspect-ratio: 1;
    background: var(--color-tl-sky);
  }
</style>

