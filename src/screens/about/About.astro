---
// More about me: a light terminal, in the look of the "Roman Chas" strip, with an agent that has five skills.
import BackToIntro from '../../components/BackToIntro.astro';
import Terminal from './Terminal';
---

<section id="about" data-screen class="overflow-hidden bg-white text-black">
  <BackToIntro class="rounded-full border border-black font-jetbrains text-sm hover:bg-black hover:text-white" />
  <div class="mx-auto flex h-full max-w-[1100px] flex-col px-[5vw] pt-[10svh] pb-[5svh]">
    <h2 class="mb-6 font-['Bricolage_Grotesque_Variable'] text-[clamp(2.4rem,4vw,4rem)] leading-none font-extrabold tracking-[-0.03em] [font-variation-settings:'wdth'_75]">
      More about me
    </h2>
    <div class="min-h-0 flex-1">
      <Terminal client:idle />
    </div>
  </div>
</section>
