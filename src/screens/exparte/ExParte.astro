---
import BackToIntro from '../../components/BackToIntro.astro';
import ExParteLogo from '../../components/ExParteLogo.astro';
import { projects } from '../../content/projects';
import { findings } from './data';

const project = projects.find((item) => item.id === 'exparte')!;
const role = project.roles[0];
const since = new Intl.DateTimeFormat('en', { month: 'long', year: 'numeric' }).format(
  new Date(`${role.period.start}-01T00:00:00Z`),
);
---

<section id="exparte" data-screen class="relative h-svh overflow-hidden bg-xp-void font-geist text-white">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(55%_65%_at_68%_45%,rgb(0_97_255/0.14),transparent_70%)]"
  >
  </div>
  <canvas class="absolute inset-0 size-full" aria-hidden="true"></canvas>
  <BackToIntro class="rounded-md border border-xp-rule bg-xp-panel font-geist-mono text-sm text-xp-mist hover:border-xp-cyan hover:text-white" />

  <div data-column class="relative flex h-full w-full flex-col justify-center px-[5vw] min-[900px]:w-[38%]">
    <h2><ExParteLogo class="block h-auto w-[clamp(15rem,26vw,28rem)]" /></h2>
    <p class="mt-5 font-geist-mono text-sm text-xp-mist">{role.title} through Mad Devs, since {since}</p>
    <p class="mt-8 max-w-[30em] text-lg leading-relaxed text-xp-mist">
      Ex Parte models the patent litigation ecosystem to find what decides a case. I keep its portal running and
      growing, from the interface down to the data.
    </p>
    <p class="mt-6 font-geist-mono text-sm text-xp-slate">{project.stack.join(', ')}</p>

    <p class="mt-12 text-sm text-xp-slate">Five nodes glow. Pick one to send an agent through the graph.</p>
    <ul class="mt-5 flex flex-col border-t border-xp-rule">
      {
        findings.map((finding) => (
          <li class="border-b border-xp-rule" data-item={finding.id}>
            <button
              type="button"
              data-finding={finding.id}
              aria-expanded="false"
              aria-controls={`finding-${finding.id}`}
              class="finding flex w-full cursor-pointer items-center py-3 text-left text-xp-mist transition-colors hover:text-white aria-expanded:text-white"
            >
              {finding.title}
            </button>
            <div id={`finding-${finding.id}`} class="detail" aria-live="polite">
              <div class="min-h-0 overflow-hidden">
                <p data-path class="font-geist-mono text-xs leading-relaxed text-xp-cyan" />
                <div class="result">
                  <p class="mt-3 max-w-[32em] leading-relaxed text-xp-mist">{finding.body}</p>
                  {finding.stack.length > 0 && (
                    <p class="mt-3 font-geist-mono text-xs text-xp-slate">{finding.stack.join(', ')}</p>
                  )}
                </div>
                <div class="h-4" />
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* The open finding gets the same short rule the nav uses on this screen. */
  .finding::before {
    content: '';
    display: inline-block;
    width: 0;
    height: 1px;
    margin-right: 0;
    background: var(--color-xp-cyan);
    transition:
      width 300ms ease,
      margin-right 300ms ease;
  }

  .finding[aria-expanded='true']::before {
    width: 1.25em;
    margin-right: 0.6em;
  }

  .detail {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 450ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  [data-item][data-open] .detail {
    grid-template-rows: 1fr;
  }

  .result {
    opacity: 0;
    translate: 0 0.4rem;
    transition:
      opacity 400ms ease,
      translate 400ms ease;
  }

  [data-item][data-state='done'] .result {
    opacity: 1;
    translate: 0 0;
  }
</style>

<script>
  import { findings, nodes } from './data';
  import type { Graph } from './graph';

  const root = document.documentElement;
  const screen = document.getElementById('exparte')!;
  const canvas = screen.querySelector('canvas')!;
  const column = screen.querySelector<HTMLElement>('[data-column]')!;
  const items = new Map(
    Array.from(screen.querySelectorAll<HTMLElement>('[data-item]')).map((item) => [item.dataset.item!, item]),
  );
  const buttons = Array.from(screen.querySelectorAll<HTMLButtonElement>('[data-finding]'));
  const labels = new Map(nodes.map((node) => [node.id, node.label]));
  const isActive = () => root.dataset.activeScreen === 'exparte';
  let opened = false;

  const route = (path: string[]) => path.map((id) => labels.get(id)).join(' → ');

  function open(id: string) {
    opened = true;
    for (const [itemId, item] of items) {
      const isOpen = itemId === id;
      item.toggleAttribute('data-open', isOpen);
      if (!isOpen) delete item.dataset.state;
      item.querySelector('button')!.setAttribute('aria-expanded', String(isOpen));
    }
  }

  function showStep(path: string[], reached: number) {
    const item = items.get(path.at(-1)!)!;
    item.dataset.state = 'running';
    item.querySelector('[data-path]')!.textContent =
      route(path.slice(0, reached + 1)) + (reached < path.length - 1 ? ' → …' : '');
  }

  function showFinding(id: string) {
    const item = items.get(id)!;
    item.dataset.state = 'done';
    item.querySelector('[data-path]')!.textContent = route(findings.find((finding) => finding.id === id)!.path);
  }

  // The graph and d3-force load only when the screen comes near.
  let loading: Promise<Graph> | undefined;
  function load() {
    loading ??= Promise.all([import('./graph'), document.fonts.load('11px "Geist Mono Variable"')]).then(
      ([{ createGraph }]) =>
        createGraph(canvas, {
          reducedMotion: matchMedia('(prefers-reduced-motion: reduce)').matches,
          // Between the text column and the right padding of the screen.
          zone: () => ({ left: column.getBoundingClientRect().right, right: screen.clientWidth * 0.95 }),
          onRun: open,
          onStep: showStep,
          onArrive: showFinding,
        }),
    );
    return loading;
  }

  let introduced = false;
  async function activate() {
    const graph = await load();
    if (!isActive()) return;
    graph.start();
    if (introduced) return;
    introduced = true;
    await graph.whenAssembled;
    // One agent run shows what the graph is for, unless the visitor already sent one.
    if (isActive() && !opened) graph.run(findings[0].id);
  }

  for (const button of buttons) {
    button.addEventListener('click', async () => (await load()).run(button.dataset.finding!));
  }

  document.addEventListener('screen:change', async (event) => {
    if ((event as CustomEvent<{ id: string }>).detail.id === 'exparte') activate();
    else (await loading)?.stop();
  });

  new IntersectionObserver(([entry]) => entry.isIntersecting && load(), { rootMargin: '100% 0px' }).observe(screen);
  if (isActive()) activate();
</script>
