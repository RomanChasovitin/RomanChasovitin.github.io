---
// Ex Parte, laid out like Mad Devs: the story on the left in the dark brand of exparte.com, the product on
// the right in its own light look. The three workflows on the left switch the portal window.
import BackToIntro from '../../components/BackToIntro.astro';
import ExParteLogo from '../../components/ExParteLogo.astro';
import { projects } from '../../content/projects';
import Portal from './Portal';

const project = projects.find((item) => item.id === 'exparte')!;
const role = project.roles[0];
const since = new Intl.DateTimeFormat('en', { month: 'long', year: 'numeric' }).format(
  new Date(`${role.period.start}-01T00:00:00Z`),
);

const workflows = [
  { id: 'intelligence', title: 'Patent intelligence', body: 'Three AI reports on one patent, each checked by triage and a panel of reviewers.' },
  { id: 'search', title: 'Search', body: 'Judges, attorneys, cases, law firms and experts, linked to each other.' },
  { id: 'assistant', title: 'Assistant', body: 'A chat about a case, with your own documents in its context.' },
];
---

<section id="exparte" data-screen class="overflow-hidden bg-xp-void font-geist text-white">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(50%_60%_at_72%_50%,rgb(0_97_255/0.16),transparent_70%)]"></div>
  <BackToIntro class="rounded-md border border-xp-rule bg-xp-panel font-geist-mono text-sm text-xp-mist hover:border-xp-cyan hover:text-white" />

  <div class="relative flex h-full items-center gap-[3.5vw] px-[5vw]">
    <div class="w-[27vw] shrink-0">
      <h2><ExParteLogo class="block h-auto w-[clamp(11rem,17vw,18rem)]" /></h2>
      <p class="mt-6 text-[clamp(1.7rem,2.5vw,2.7rem)] leading-[1.1] font-medium tracking-[-0.03em]">
        Litigation intelligence for patent lawyers
      </p>
      <p class="mt-4 font-geist-mono text-sm text-xp-mist">{role.title} through Mad Devs, since {since}</p>
      <p class="mt-6 leading-relaxed text-xp-mist">
        Ex Parte shows patent lawyers what decides a case: the judge, the lawyers and experts on the other side,
        the weak points of a patent. I build the whole front end of its portal and the BFF on NestJS behind it.
      </p>

      <ul class="mt-8 flex flex-col border-t border-xp-rule">
        {
          workflows.map((workflow) => (
            <li class="border-b border-xp-rule">
              <button
                type="button"
                data-workflow={workflow.id}
                aria-pressed={workflow.id === 'intelligence' ? 'true' : 'false'}
                class="workflow flex w-full cursor-pointer flex-col py-3 text-left text-xp-mist transition-colors hover:text-white aria-pressed:text-white"
              >
                <span class="flex items-center">{workflow.title}</span>
                <span class="mt-1 text-sm text-xp-slate">{workflow.body}</span>
              </button>
            </li>
          ))
        }
      </ul>

      <p class="mt-6 font-geist-mono text-sm text-xp-slate">{project.stack.join(', ')}</p>
    </div>

    <div class="h-[82svh] min-w-0 flex-1">
      <Portal client:idle />
    </div>
  </div>
</section>

<style>
  /* The open workflow gets a short cyan rule, as the nav of exparte.com does. */
  .workflow > span:first-child::before {
    content: '';
    display: inline-block;
    width: 0;
    height: 1px;
    margin-right: 0;
    background: var(--color-xp-cyan);
    transition:
      width 300ms ease,
      margin-right 300ms ease;
  }

  .workflow[aria-pressed='true'] > span:first-child::before {
    width: 1.25em;
    margin-right: 0.6em;
  }
</style>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('#exparte [data-workflow]'));

  for (const button of buttons) {
    button.addEventListener('click', () =>
      document.dispatchEvent(new CustomEvent('exparte:workflow', { detail: { workflow: button.dataset.workflow } })),
    );
  }

  // The portal says which workflow it shows, including after a click inside it.
  document.addEventListener('exparte:view', (event) => {
    const { workflow } = (event as CustomEvent<{ workflow: string }>).detail;
    for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.workflow === workflow));
  });
</script>
